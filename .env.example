# ======================================================================================================
# n8n-automation-hub - environment reference. Copy the secrets you need into secrets/*.env (gitignored)
# for local runs, or into Render's environment for the deployed demo. NEVER commit real values.
# ======================================================================================================

# --- Runtime / networking -------------------------------------------------------------------------
PORT=10000                       # public port. Render injects it. start.sh keeps it CLOSED until the owner is claimed.
N8N_PORT=5679                    # private n8n port behind the gate (set by start.sh; leave alone)
WEBHOOK_URL=https://YOUR-SERVICE.onrender.com/     # public base URL n8n advertises for webhooks (trailing slash)
N8N_EDITOR_BASE_URL=https://YOUR-SERVICE.onrender.com/
N8N_HOST=YOUR-SERVICE.onrender.com
N8N_PROTOCOL=https
N8N_PROXY_HOPS=1                 # Render terminates TLS: trust exactly one proxy hop (correct client IP / https)
N8N_SECURE_COOKIE=true           # cookies only over https (set false ONLY for plain-http localhost)
N8N_DISABLE_UI=true              # headless runner: ~90 MB less RAM, no public editor. false = editor available
N8N_PUBLIC_API_DISABLED=true     # this repo never uses the n8n public REST API
N8N_PAYLOAD_SIZE_MAX=1           # MB. Hard edge limit on request bodies (webhooks also validate size in-workflow)

# --- Secrets ------------------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=              # 64 hex chars (openssl rand -hex 32). Encrypts stored credentials. Losing it = re-create credentials
N8N_OWNER_EMAIL=owner@n8n-hub.local
N8N_OWNER_PASSWORD=              # >= 8 chars with a number and a capital. Used by bootstrap_owner to claim the instance
LLM_API_KEY=                     # Groq (or any OpenAI-compatible) key for hub-support-triage-ai. Empty = keyword fallback only
HUB_NOTIFY_URL=                  # Discord/Slack-compatible incoming-webhook URL. Empty = notifications are skipped

# --- Database: Supabase Postgres via the SESSION POOLER (IPv4-friendly), dedicated schema -----------
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=aws-0-eu-west-2.pooler.supabase.com   # pooler host of your Supabase region
DB_POSTGRESDB_PORT=5432                                  # 5432 = session pooler (persistent connections, what n8n needs)
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.<project-ref>                # NOTE the ".<project-ref>" suffix required by the pooler
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SCHEMA=n8n                                 # n8n's own tables; app tables live in schema "hub" (sql/001_hub_schema.sql)
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false              # pooler presents Supabase's CA; set true if you add the CA bundle
DB_POSTGRESDB_POOL_SIZE=2                                # keep connections low: free-tier pooler limits

# --- Housekeeping / privacy -----------------------------------------------------------------------
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=48                               # hours of execution history kept (demo data only, keep it short)
EXECUTIONS_DATA_PRUNE_MAX_COUNT=500
N8N_DIAGNOSTICS_ENABLED=false                            # no telemetry
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_RUNNERS_ENABLED=false                                # no separate task-runner process (saves RAM; Code nodes run in-process)
NODE_OPTIONS=--max-old-space-size=200 --max-semi-space-size=1   # lives in config/lean.env: V8 heap cap for the 512 MB free tier
HUB_LEAN=true                                            # load config/lean.env (only the nodes this repo uses, unused modules off)
GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid

# --- Code-node capabilities (kept to the minimum the workflows need) -----------------------------
NODE_FUNCTION_ALLOW_BUILTIN=crypto                       # idempotency keys use sha256
N8N_BLOCK_ENV_ACCESS_IN_NODE=false                       # workflows read HUB_*/FX_*/SCRAPE_* via $env. Only the owner can edit workflows

# --- Workflow configuration (all optional) --------------------------------------------------------
LLM_BASE_URL=https://api.groq.com/openai/v1              # any OpenAI-compatible endpoint
LLM_MODEL=openai/gpt-oss-20b
HUB_LLM_TIMEOUT_MS=15000                                 # LLM call timeout before the keyword fallback takes over
HUB_SELF_URL=http://localhost:5679                       # where dead-letter replay posts (the private n8n port)
HUB_CHAOS=false                                          # TESTS ONLY: enables the x-hub-chaos fault-injection header. Never true in prod
FX_BASE=EUR
FX_SYMBOLS=USD,GBP,CHF,JPY,CNY
FX_HISTORY_DAYS=30
FX_PCT_THRESHOLD=0.7                                     # |1-day move| in % that triggers an alert
FX_Z_THRESHOLD=2                                         # |z-score| of the last daily return that triggers an alert
SCRAPE_PAGES=3                                           # catalogue pages crawled (20 books each)
SCRAPE_DELAY_S=1                                         # polite delay between pages
SCRAPE_DROP_PCT=5                                        # price drop % that raises an alert
SCRAPE_BASE_URL=https://books.toscrape.com               # sandbox site built for scraping practice

# --- Tests / CI only -------------------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678                       # target of the pytest suite (also a GitHub repo *variable* used by keepalive.yml)
NOTIFY_MOCK_URL=http://127.0.0.1:5699                    # tests/mock_services.py
