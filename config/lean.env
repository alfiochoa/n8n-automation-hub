# Memory-lean n8n profile (free tier = 512 MB). Sourced by run_local.sh and baked into the Docker image.
# Only the node types this repo uses are loaded, unused core modules are off, V8 is told to stay small.
NODES_INCLUDE='["n8n-nodes-base.webhook","n8n-nodes-base.code","n8n-nodes-base.if","n8n-nodes-base.switch","n8n-nodes-base.httpRequest","n8n-nodes-base.postgres","n8n-nodes-base.scheduleTrigger","n8n-nodes-base.manualTrigger","n8n-nodes-base.wait","n8n-nodes-base.splitInBatches","n8n-nodes-base.executeWorkflow","n8n-nodes-base.executeWorkflowTrigger","n8n-nodes-base.errorTrigger","n8n-nodes-base.htmlExtract","n8n-nodes-base.respondToWebhook","n8n-nodes-base.stickyNote","n8n-nodes-base.noOp","n8n-nodes-base.set"]'
N8N_DISABLED_MODULES=insights,chat-hub,external-secrets,mcp,data-table,breaking-changes
N8N_AI_ENABLED=false
N8N_METRICS=false
DB_POSTGRESDB_POOL_SIZE=2
NODE_OPTIONS='--max-old-space-size=200 --max-semi-space-size=1'
